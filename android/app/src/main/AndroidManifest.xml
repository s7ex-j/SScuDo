<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para los reportes, la revisión de páginas en el servicio y preguntar a los
         acortadores a dónde redirigen. El análisis del texto no usa red. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para mostrar la alerta cuando llega un mensaje con marcas de estafa. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para encontrar el navegador al que se le pasa el enlace ya revisado. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Compartir → SScuDo -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Seleccionar texto en cualquier app → "Revisar con SScuDo" -->
            <intent-filter android:label="@string/revisar_con">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Revisor de enlaces: recibe el toque, mira la dirección y la pasa al navegador. -->
        <activity
            android:name=".LinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Tema.Transparente">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Botón "Revisar copiado" en los ajustes rápidos. -->
        <service
            android:name=".RevisarCopiadoTile"
            android:exported="true"
            android:icon="@drawable/ic_escudo"
            android:label="@string/revisar_copiado"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lee el texto de las notificaciones entrantes. Solo se activa si la persona lo permite en Ajustes. -->
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
