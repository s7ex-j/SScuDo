{
  "name": "SScuDo",
  "short_name": "SScuDo",
  "description": "Pega un mensaje sospechoso y mira qué tiene de raro. El análisis ocurre en tu dispositivo.",
  "lang": "es-PE",
  "start_url": "./app/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#151923",
  "theme_color": "#151923",
  "icons": [
    { "src": "iconos/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "iconos/icono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "iconos/icono.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./app/compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
